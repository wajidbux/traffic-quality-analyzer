# =============================================================================
# Traffic Quality Analyzer — environment configuration
# Copy to .env (or set in your environment) and fill in the values.
# NEVER commit the real .env file or the real Pixalate API key.
# =============================================================================

# --- Pixalate Ad Fraud API ------------------------------------------------
# Your Pixalate API key. Loaded on the SERVER only — it is never sent to the
# browser, never logged, and never written into reports or exports.
PIXALATE_API_KEY=

# Base URL of the Pixalate Ad Fraud API.
# Default: https://fraud-api.pixalate.com (Pixalate's dedicated Ad Fraud host).
# IMPORTANT: The Ad Fraud API is hosted on fraud-api.pixalate.com. The key must
# be provisioned for the Ad Fraud product ON THIS HOST, or you will get 401.
#
# Some Pixalate accounts route the Ad Fraud API through api.pixalate.com instead.
# If your key works against https://api.pixalate.com/api/v2/fraud, set this to:
#   PIXALATE_BASE_URL=https://api.pixalate.com
#
# WARNING: If you set api.pixalate.com but the /api/v2/fraud path is NOT
# registered on that host, you will get 403 MissingAuthenticationToken.
PIXALATE_BASE_URL=https://fraud-api.pixalate.com

# Fraud analysis endpoint path. Metadata/quota uses the SAME endpoint with NO
# query parameters (per the spec: "Not specifying an IP, Device, or Agent will
# return the metadata for fraud, including the user's current quota").
PIXALATE_FRAUD_PATH=/api/v2/fraud

# --- Pixalate CTV Apps API -----------------------------------------------
# The CTV Apps API lives at a different server (api.pixalate.com) but uses
# the same PIXALATE_API_KEY. Enable when your account has CTV Apps access.
PIXALATE_CTV_BASE_URL=https://api.pixalate.com
# GET /mrt/ctv (quota/metadata) and GET /mrt/ctv/{appId} (app risk/reputation)
PIXALATE_CTV_PATH=/mrt/ctv

# --- Webhook / API ingestion ----------------------------------------------
# Lets an ad server or SSP push traffic records in via POST /api/ingest.
# This is a SEPARATE key from the Pixalate key — never reuse PIXALATE_API_KEY.
# Empty (default) = ingestion endpoint disabled.
INGESTION_API_KEY=
# Maximum records per ingestion request
INGESTION_MAX_BATCH=1000
# Maximum ingestion requests per minute
INGESTION_RATE_PER_MINUTE=120

# --- Application -----------------------------------------------------------
# development | test | production
APP_ENV=development
# debug | info | warn | error | silent
LOG_LEVEL=info
# HTTP port for the backend API
PORT=3001

# --- Database --------------------------------------------------------------
# SQLite (local first version):
#   DATABASE_URL=sqlite:./data/tqa.sqlite
#
# PostgreSQL (same schema, same APIs — no code changes):
#   DATABASE_URL=postgres://user:password@localhost:5432/traffic_quality
#
# The server applies the schema automatically on startup for both drivers.
# For SQLite, DATABASE_DIR controls where the DB file is created.
DATABASE_URL=sqlite:./data/tqa.sqlite
DATABASE_DIR=./data
# TEST_DATABASE_URL — set to a Postgres URL to run live PG integration tests
#   TEST_DATABASE_URL=postgres://user:password@localhost:5432/tqa_test
TEST_DATABASE_URL=

# --- Analysis engine defaults (overridable in Settings) --------------------
# Conservative defaults: 30 req/min, 5 concurrent, up to 2 retries.
REQUESTS_PER_MINUTE=30
MAX_CONCURRENCY=5
RETRY_DELAY_MS=1000
MAX_RETRIES=2
REQUEST_TIMEOUT_MS=10000

# --- Quota warnings (requests remaining) -----------------------------------
QUOTA_WARN_YELLOW=800
QUOTA_WARN_RED=200

# --- Risk bands (analytical categories, 0-1) -------------------------------
RISK_BAND_ELEVATED_FROM=0.5
RISK_BAND_HIGH_FROM=0.75
RISK_BAND_VERY_HIGH_FROM=0.9

# Mask sensitive values (IPs, RIDAs) in the UI and exports
MASK_SENSITIVE=true

# Data retention in days (0 = keep forever)
RETENTION_DAYS=0